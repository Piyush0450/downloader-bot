# ====================================================================
# Productivity Hub Telegram Bot - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file containing secrets to version control!
# ====================================================================

# [MANDATORY] Telegram Bot API token obtained from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=

# [MANDATORY] Numeric Telegram User ID of the primary administrator / owner
# Example: 123456789
OWNER_ID=

# [OPTIONAL] Cryptographic secret key for session/token encryption.
# If left blank, a secure 64-character hex key will be auto-generated at startup.
SECRET_KEY=

# [OPTIONAL] Channel username (e.g. @MyChannel) required for bot usage verification
CHANNEL_USERNAME=

# [OPTIONAL] Operational mode: 'polling' (local development) or 'webhook' (production)
# Default: polling
BOT_MODE=polling

# [OPTIONAL] Public HTTPS URL for Telegram webhook mode (Required if BOT_MODE=webhook)
# Example: https://productivity-hub.onrender.com
WEBHOOK_URL=

# [OPTIONAL] Port to run the aiohttp health check web server (Render default: 8000)
# Default: 8000
PORT=8000

# [OPTIONAL] SQLite database file path (relative or absolute)
# Default: database/app.sqlite3
DATABASE_PATH=database/app.sqlite3

# [OPTIONAL] Logging verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# [OPTIONAL] Task processing queue concurrency settings
# Max concurrent background tasks overall (2 recommended for Render 512MB tier)
MAX_CONCURRENT_TASKS=2

# Max active tasks allowed per single user concurrently
MAX_USER_ACTIVE_TASKS=1

# Max queued tasks allowed per single user
MAX_USER_QUEUE_TASKS=3

# Maximum size of the global background task queue
MAX_QUEUE_SIZE=50

# [OPTIONAL] File retention period for temporary uploads/downloads in minutes
# Default: 60
TEMP_RETENTION_MINUTES=60

# [OPTIONAL] Maximum allowed file upload/download size in Megabytes (MB) or exact bytes
# Default: 50 MB / 52428800 bytes (aligned with Telegram Bot API limit)
MAX_FILE_SIZE=50
MAX_FILE_SIZE_BYTES=52428800

# [OPTIONAL] Maintenance mode toggle (true/false)
# Default: false
MAINTENANCE_MODE=false
