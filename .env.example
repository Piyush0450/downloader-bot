# [REQUIRED] Telegram Bot API token obtained from @BotFather
BOT_TOKEN=6500080341:AAHXgiLOPP7rQ3LZrMHtO2SmCu-N0ymLogE

# [REQUIRED] Numeric Telegram User ID of the primary owner/administrator
OWNER_ID=1530123674

# [REQUIRED] Secure cryptographic key for encryption (generate a long random string)
SECRET_KEY=

# [OPTIONAL] Channel username for verification/checks (e.g., @mychannel)
CHANNEL_USERNAME=

# [REQUIRED] Bot operational mode: 'polling' (local dev) or 'webhook' (production)
BOT_MODE=polling

# [REQUIRED ONLY FOR WEBHOOK MODE] Public HTTPS URL where the webserver is reachable
WEBHOOK_URL=

# [REQUIRED] Server port to bind webserver (FastAPI) to (default: 8000)
PORT=8000

# [REQUIRED] SQLite Database filename relative to the root directory
DATABASE_PATH=database/bot.db

# [REQUIRED] Full SQLAlchemy-style SQLite database URL
DATABASE_URL=sqlite:///database/bot.db

# [REQUIRED] Console and file logger verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
