# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment configuration & secrets
.env
.env.local
.env.*.local

# Databases & SQLite
*.sqlite
*.sqlite3
*.db
database/*.sqlite3
database/*.db
!database/**/.gitkeep

# Log files & directories
logs/
*.log

# Temporary processing files
temp/*
!temp/**/.gitkeep
backups/*
!backups/**/.gitkeep

# IDE & Editor specific
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
